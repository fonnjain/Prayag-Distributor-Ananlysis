# --- Google Sheets access (server-side service account) ---
# Paste the ENTIRE contents of the service-account JSON key file as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Claude (analyst + audit) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: a (cheaper/faster) model for the twice-daily audit. Falls back to ANTHROPIC_MODEL.
AUDIT_MODEL=claude-sonnet-5

# --- App ---
PORT=3000
# Fiscal year to build (Apr..Mar). Row-level dates decide membership, not file names.
DEFAULT_FY=2025-26
# Protects the /cron/audit route. Set to any random string; pass as ?token=... from the scheduler.
CRON_TOKEN=change-me
# Optional Slack Incoming Webhook for warn/fail alerts. If empty, alerts log to console.
SLACK_WEBHOOK_URL=
