modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "comparison-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prayag-period-guards"

[[workflows.workflow]]
name = "comparison-guards"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec vitest run src/lib/comparison/costCell.test.ts src/lib/mgmt/distributorTabs.test.ts && node artifacts/api-server/scripts/comparison-guard-check.mjs && node artifacts/api-server/scripts/distributor-tab-guard-check.mjs"

[[workflows.workflow]]
name = "prayag-period-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/prayag exec vitest run src/lib/__tests__/periodRange.test.ts src/data/__tests__/period-capability.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[userenv.production]
